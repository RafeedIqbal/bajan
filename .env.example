# Supabase project URL and publishable key (local values come from `npx -y supabase@2.119.0 status`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Must belong to a Google Cloud project with an active billing account (Gemini "Paid Services").
# The unpaid tier's terms forbid personal information, and testers' voices are personal information.
GEMINI_API_KEY=

# Simulated caregiver call outcome: answered | no_answer | error | timeout
SIMULATED_CALL_OUTCOME=answered
